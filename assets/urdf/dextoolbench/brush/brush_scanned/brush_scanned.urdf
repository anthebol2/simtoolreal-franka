<?xml version="1.0"?>
<!-- Lab brush (brush.usdz scan, handle artifact trimmed), re-framed to the
     red_brush axis convention (handle -x, head +x, bristles +z). FP tracks the
     ORIGINAL scan; the relay applies brush_scanned_reframe.json. -->
<robot name="brush_scanned">
  <link name="brush_scanned">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="brush_scanned.obj" scale="1 1 1"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="brush_scanned.obj" scale="1 1 1"/></geometry></collision>
    <inertial><density value="400.0"/></inertial>
  </link>
</robot>

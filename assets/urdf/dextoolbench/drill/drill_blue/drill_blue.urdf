<?xml version="1.0"?>
<!-- Onboarded any2any scan (0818_task2_traj_tracking/assets/scene6/textured.obj). Canonical frame: z-up
     (scan frame kept as-is).
     Density: uniform-sampled per training variant (simtoolreal primitive
     convention, LOW range 300-600 kg/m^3); the value below is the base. -->
<robot name="drill_blue">
  <link name="drill_blue">
    <visual><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="drill_blue.obj" scale="1 1 1"/></geometry></visual>
    <collision><origin xyz="0 0 0" rpy="0 0 0"/><geometry><mesh filename="drill_blue.obj" scale="1 1 1"/></geometry></collision>
    <inertial><density value="450.0"/></inertial>
  </link>
</robot>

    <child link="panda_panda_link7"/>
    <axis xyz="1. 0. 0."/>
    <limit lower="-2.8973001" upper="2.8973001" effort="7.1999998" velocity="10.0000005"/>
  </joint>
  <!-- panda_joint8: restore the 0.107 m flange offset along link7's +X axis -->
  <joint name="panda_joint8" type="fixed">
    <origin xyz="0.1069999 0. 0." rpy="3.1415925 0. -3.1415894"/>
    <parent link="panda_panda_link7"/>
    <child link="panda_link8"/>
  </joint>

  <!-- ========== Franka-to-Sharpa Connection Joints ========== -->
  <!-- panda_link8 → connector: connector frame coincides with flange frame -->
  <joint name="panda_to_connector" type="fixed">
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
    <parent link="panda_link8"/>
    <child link="connector"/>
  </joint>
  <!-- connector → wrist_interface: Wrist-Interface adapter sits on connector
       flange A. Its bottom face (mesh z=0, bolt-circle center at mesh (0,0))
       is placed at connector flange A bolt-circle in connector link frame
       (-0.040001, -0.000317, 0.084512). Wrist mesh +Z = mating axis = connector
       link +Z, so rpy=(0,0,0). The wrist link frame origin coincides with the
       bottom face center; top face at link z=0.031 m. -->
  <joint name="connector_to_wrist" type="fixed">
    <origin xyz="-0.040001 -0.000317 0.084512" rpy="0. 0. 0."/>
    <parent link="connector"/>
    <child link="wrist_interface"/>
  </joint>
  <!-- wrist_interface → right_hand_C_MC: hand mount face (mesh -Z, bolt-circle
       at mesh (0.000589, 0.000055)) seats on wrist top face (link z=0.031).
       rpy=(0,0,π) preserves prior palm-down orientation. J_xyz solves
       A_bolt_wrist = J_xyz + Rz(π)·H_bolt_hand. -->
  <joint name="wrist_to_sharpa" type="fixed">
    <origin xyz="0.000589 0.000055 0.031" rpy="0. 0. 3.1415927"/>
    <parent link="wrist_interface"/>
    <child link="right_hand_C_MC"/>
  </joint>

  <!-- ========== Franka Arm Links ========== -->
  <link name="panda"/>

  <!-- Connector link: 90° elbow adapter between franka flange and sharpa palm.
       Uses connector.STL (mm, scale=0.001) with two circular flange faces:
           flange A   centroid (mesh, mm) ≈ (115.0, 51.54, 34.16)  normal +X
           flange B   centroid (mesh, mm) ≈ ( 30.49,  8.0, 33.68)  normal -Y

       Mating assignment (per user — reversed from previous attempt):
           flange B  →  franka panda_link8
           flange A  →  sharpa right_hand_C_MC

       The visual transform R = Rx(π/2)·Rz(π/2) maps:
           mesh -Y (flange B normal)  →  link +X      (mate franka -X)
           mesh +X (flange A normal)  →  link +Z      (90° elbow turn)
           mesh +Z                   →  link +Y
       Translation xyz = -R·P_B_mesh = (0.008, 0.0337, -0.0305) m places
       flange B center exactly at the connector link origin. Flange A then
       falls at link (-0.0436, -0.0005, 0.0845) m. -->
  <link name="connector">
    <visual>
      <origin xyz="0.008 0.03368203 -0.03048782" rpy="0. -1.5707963 1.5707963"/>
      <geometry>
        <mesh filename="meshes/connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="connector_gray">
        <color rgba="0.8 0.8 0.8 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0.008 0.03368203 -0.03048782" rpy="0. -1.5707963 1.5707963"/>
      <geometry>
        <mesh filename="meshes/connector.STL" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="-0.037 0. 0.027" rpy="0. 0. 0."/>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0." ixz="0." iyy="0.0001" iyz="0." izz="0.0001"/>
    </inertial>
  </link>
  <!-- Wrist-Interface adapter (Wrist-Interface.stl, mm, scale=0.001).
       Link frame: origin at bottom mating face center, +Z = mating axis up.
       Mesh bbox: x∈[-24, 24] mm, y∈[-21, 21] mm, z∈[0, 31] mm.
       Bottom face bolt-circle (mesh, mm): (0, 0) on z=0 face (4 bolts in
         ±16 × ±3.5 rectangle). Top face bolt-circle: (0, 0) on z=31 face
         (4 bolts in ±20.8 × ±15.1 rectangle). Axial length = 31 mm. -->
  <link name="wrist_interface">
    <visual>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/Wrist-Interface.stl" scale="0.001 0.001 0.001"/>
      </geometry>
      <material name="wrist_gray">
        <color rgba="0.7 0.7 0.75 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
      <geometry>
        <mesh filename="meshes/Wrist-Interface.stl" scale="0.001 0.001 0.001"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0. 0. 0.0155" rpy="0. 0. 0."/>
      <mass value="0.1"/>
      <inertia ixx="0.0001" ixy="0." ixz="0." iyy="0.0001" iyz="0." izz="0.0001"/>
    </inertial>
  </link>

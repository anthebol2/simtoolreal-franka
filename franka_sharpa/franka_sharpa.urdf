<?xml version="1.0" encoding="UTF-8"?>
<robot name="franka_sharpa">
  <mujoco>
    <compiler meshdir="meshes"/>
  </mujoco>
  <!-- ========== Franka Arm Joints ========== -->
  <joint name="rootJoint" type="fixed">
    <origin xyz="0. 0. 0." rpy="0. 0. 0."/>
    <parent link="panda"/>
    <child link="panda_panda_link0"/>
  </joint>
  <joint name="panda_joint1" type="revolute">

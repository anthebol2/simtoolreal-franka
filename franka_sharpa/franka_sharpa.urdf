    <limit lower="-3.0718" upper="-0.0698" effort="150." velocity="10.0000005"/>
  </joint>
  <joint name="panda_joint5" type="revolute">
    <origin xyz="0.0000005 0.3839998 0.0824996" rpy="-0.0000003 0.0000001 1.5707946"/>
